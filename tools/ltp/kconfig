# The kernel options that LTP checks, as rukernel gives them. LTP reads this file through
# KCONFIG_PATH, because rukernel has no /proc/config.gz. An option that is not here is off.
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_MMU=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_PROC_FS=y
CONFIG_TMPFS=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CHECKPOINT_RESTORE=y
